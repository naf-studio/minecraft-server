# ==============================================================================
# Script Name: pinatarandom.sk
# Description: Spawns pinatas on random online players using the Pinata plugin.
# ==============================================================================

# ------------------------------------------------------------------------------
# Options
# ------------------------------------------------------------------------------
options:
  prefix: &b[PinataRandom]

# ------------------------------------------------------------------------------
# Command: /pinatarandom
# Purpose: Spawns a specified number of pinatas on random online players.
# Permission: op
# Usage:
#   /pinatarandom [amount]
# Arguments:
#   - [amount] (optional): The number of pinatas to spawn. Defaults to 1.
# ------------------------------------------------------------------------------
command /pinatarandom [<number>]:
  permission: op
  trigger:
    if arg is not set:
      set {_amount} to 1
    else if arg is integer:
      set {_amount} to arg
    else:
      send "{@prefix} &cAmount must be a number."
      stop

    if {_amount} < 1:
      send "{@prefix} &cAmount must be at least 1."
      stop

    if size of all players < 1:
      send "{@prefix} &cNo players online."
      stop

    loop {_amount} times:
      set {_target} to random element out of all players
      execute console command "pinata spawn %{_target}%"
      send "{@prefix} &fSpawned pinata on %{_target}%."
