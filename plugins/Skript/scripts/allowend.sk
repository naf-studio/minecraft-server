# ==============================================================================
# Script Name: allowend.sk
# Description: Manages access to The End world. Allows enabling, disabling,
#              and toggling access. When disabled, players in The End are
#              teleported to the Overworld spawn.
# ==============================================================================

# ------------------------------------------------------------------------------
# Options
# ------------------------------------------------------------------------------
options:
  prefix: &b[AllowEnd]

# ------------------------------------------------------------------------------
# Command: /allowend
# Purpose: Enables, disables, or toggles access to The End.
# Permission: op
# Usage:
#   /allowend          - Toggles the current state.
#   /allowend <true>   - Forces The End to be enabled.
#   /allowend <false>  - Forces The End to be disabled and teleports players out.
# Arguments:
#   - <boolean> (optional): true to enable, false to disable. If omitted, toggles.
# ------------------------------------------------------------------------------
command /allowend [<boolean>]:
  permission: op
  trigger:
    # Check if a boolean argument was provided
    if arg 1 is set:
      # If argument is 'true', enable the End
      if arg 1 is true:
        if {endblock::enabled} is true:
          send "{@prefix} &aThe End is already enabled." to player
        else:
          set {endblock::enabled} to true
          broadcast "{@prefix} &aThe End has been enabled."
      # If argument is 'false', disable the End
      else:
        if {endblock::enabled} is false:
          send "{@prefix} &cThe End is already disabled." to player
        else:
          set {endblock::enabled} to false
          broadcast "{@prefix} &cThe End has been disabled."
          loop all players:
            if loop-player's world is "world_the_end":
              teleport loop-player to spawn of world "world"
              send "{@prefix} &cYou have been teleported to the Overworld because The End was disabled." to loop-player
    # If no argument, toggle the state
    else:
      if {endblock::enabled} is true:
        set {endblock::enabled} to false
        broadcast "{@prefix} &cThe End has been disabled."
        loop all players:
          if loop-player's world is "world_the_end":
            teleport loop-player to spawn of world "world"
            send "{@prefix} &cYou have been teleported to the Overworld because The End was disabled." to loop-player
      else:
        set {endblock::enabled} to true
        broadcast "{@prefix} &aThe End has been enabled."

# ------------------------------------------------------------------------------
# Event: on teleport
# Purpose: Prevents players from teleporting to The End if it is disabled.
# ------------------------------------------------------------------------------
on teleport:
  if event-location's world is "world_the_end":
    if {endblock::enabled} is false:
      cancel event
      send "{@prefix} &cThe End is currently disabled." to player
