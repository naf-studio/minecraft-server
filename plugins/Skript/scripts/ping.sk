# ==============================================================================
# Script Name: ping.sk
# Description: Wrapper for the Spark ping command to check latency.
# ==============================================================================

# ------------------------------------------------------------------------------
# Command: /ping
# Purpose: Checks the ping (latency) of the player or a target player.
# Usage:
#   /ping          - Checks your own ping.
#   /ping <player> - Checks the ping of the specified player.
# Arguments:
#   - <player> (optional): The player whose ping to check.
# ------------------------------------------------------------------------------
command /ping [<player>]:
  trigger:
    if arg-1 is set:
      make player execute command "spark ping --player %arg-1%"
    else:
      make player execute command "spark ping"
